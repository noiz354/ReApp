{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Android",
            "request": "launch",
            "type": "reactnative",
            "cwd": "${workspaceFolder}",
            "platform": "android",
            "internalConsoleOptions": "openOnSessionStart",
            "port": 8081,
            "enableDebug": true,
            "target": "emulator"
        },
        {
            "name": "Debug iOS",
            "request": "launch",
            "type": "reactnative",
            "cwd": "${workspaceFolder}",
            "platform": "ios",
            "internalConsoleOptions": "openOnSessionStart",
            "port": 8081,
            "enableDebug": true,
            "target": "simulator"
        }
    ]
}